{
  "name": "son-duduk",
  "version": "1.0.0",
  "private": true,
  "description": "Son Düdük — hakem kariyer simülatörü (iOS & Android)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#0c121b' --iconBackgroundColorDark '#0c121b' --splashBackgroundColor '#0c121b' --splashBackgroundColorDark '#0c121b'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
